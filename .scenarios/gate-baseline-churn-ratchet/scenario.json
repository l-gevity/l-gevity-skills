{
  "request": "Run gate-lifecycle on this: a merge gate fails when a source module exceeds its line limit, and a JSON baseline lists the modules allowed to exceed it. Whenever the gate goes red, a script regenerates the JSON from the current tree and the result is committed with whatever change was in flight. In the last 12 days the baseline was rewritten 34 times, the exception list grew from 41 to 58 modules, and no commit message mentions an addition. The gate has stayed green. What should change?",
  "skills": [
    "gate-lifecycle"
  ],
  "expect": [
    {
      "id": "applies-gate-guidance",
      "criterion": "gate-lifecycle #1: a request about a gate after placement loads the lifecycle method",
      "check": "guidance_includes",
      "skills": [
        "gate-lifecycle"
      ]
    },
    {
      "id": "ratchets-the-baseline",
      "criterion": "gate-lifecycle #6: a baseline that moves both ways is put on a ratchet",
      "check": "field_in",
      "field": "Decision",
      "values": [
        "RATCHET"
      ]
    },
    {
      "id": "growth-needs-a-name",
      "criterion": "gate-lifecycle #7: baseline growth is refused unless the change that makes it names it",
      "check": "text_matches",
      "pattern": "(?i)(growth|grow|grew|addition|new (entr\\w*|modules?)|raised? (ceiling|limit))[^.\\n]{0,120}\\b(named?|names|naming|accept\\w*|explicit\\w*|unless)\\b|\\b(named?|names|naming|accept\\w*)[^.\\n]{0,120}(growth|addition|new entr)"
    },
    {
      "id": "red-run-never-writes",
      "criterion": "gate-lifecycle #8: a red run never rewrites the baseline it failed against",
      "check": "text_matches",
      "pattern": "(?i)\\b(?:red|failing|failed)\\s+runs?\\b(?:[^.\\n]|\\.(?=\\w)){0,20}?(?:\\b(?:never|not|cannot)|n't)\\s+(?:(?:re|over)?writ(?:e|es|ing)|regenerat(?:e|es|ing)|updat(?:e|es|ing)|modif(?:y|ies|ying)|touch(?:es|ing)?|commit(?:s|ting)?)\\b|\\b(?:red|failing|failed)\\s+runs?\\b(?:[^.\\n]|\\.(?=\\w)){0,20}?\\b(?:leaves?\\b(?:[^.\\n]|\\.(?=\\w)){0,30}\\b(?:untouched|unchanged)|read-only)\\b|\\bonly\\s+(?:a\\s+|the\\s+)?(?:green|passing)\\s+runs?\\s+(?:may\\s+|can\\s+)?(?:re|over)?writes?\\b|\\b(?:red|fail(?:s|ed|ing|ure)?)\\b(?:(?!\\b(?:green|pass(?:es|ed|ing)?)\\b)(?:[^.\\n]|\\.(?=\\w))){0,40}(?:\\bwrites?\\s+nothing\\b|\\bnothing\\s+is\\s+written\\b|(?:\\b(?:never|not|cannot)|n't)\\s+(?:re|over)?writes?\\s+(?:anything\\s+)?(?:to\\s+)?(?:\\w+\\s+){0,2}?`?\\b(?:baseline|json|file|list)\\b|`?\\b(?:baseline|json|file|list)\\b(?:[^.\\n]|\\.(?=\\w)){0,12}?(?:\\b(?:never|not|cannot)|n't)\\s+(?:be\\s+)?(?:re|over)?written\\b(?!\\s+by\\b))|(?:\\bwrites?\\s+nothing\\b|\\bnothing\\s+is\\s+written\\b|(?:\\b(?:never|not|cannot)|n't)\\s+(?:re|over)?writes?\\s+(?:anything\\s+)?(?:to\\s+)?(?:\\w+\\s+){0,2}?`?\\b(?:baseline|json|file|list)\\b|`?\\b(?:baseline|json|file|list)\\b(?:[^.\\n]|\\.(?=\\w)){0,12}?(?:\\b(?:never|not|cannot)|n't)\\s+(?:be\\s+)?(?:re|over)?written\\b(?!\\s+by\\b))(?:(?!\\bunless\\b)(?:[^.;\\n]|\\.(?=\\w))){0,40}\\b(?:red|fail(?:s|ed|ing|ure)?)\\b"
    },
    {
      "id": "guard-ends-the-decision",
      "criterion": "gate-lifecycle #9: the decision carries a guard",
      "check": "field_present",
      "field": "Guard"
    },
    {
      "id": "opens-with-report-blocks",
      "criterion": "summary-led-report #2: the decision opens with the four blocks in order",
      "check": "blocks_in_order"
    }
  ]
}
